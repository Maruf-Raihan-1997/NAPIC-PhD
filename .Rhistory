# ---------------------------------------------------------
# 4. Convert p-values → asterisks
# ---------------------------------------------------------
p_to_star <- function(p) {
if (p < 0.0001) return("****")
if (p < 0.01)    return("**")
if (p < 0.05)    return("*")
return("ns")
}
