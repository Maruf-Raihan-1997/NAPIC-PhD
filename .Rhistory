library(ggplot2)
library(cowplot)
legend_plot <- ggplot(
plot2,
aes(x = amino_acid, y = mean, fill = treatment)
) +
geom_col() +
scale_fill_manual(
values = cols,
labels = labels,
name = "Sample Legend"
) +
theme_void() +
theme(
legend.position = "top"
) +
guides(
fill = guide_legend(
nrow = 2,
byrow = TRUE
)
)
legend <- cowplot::get_legend(legend_plot)
cowplot::ggdraw(legend)
